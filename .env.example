# Telegram Bot (Optional, for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Notifier (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
